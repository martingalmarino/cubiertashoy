# URL pública del sitio (sin slash final).
# En Vercel, si no la seteás, se usa automáticamente https://$VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Neon Postgres (pooled). Nunca commitear valores reales.
DATABASE_URL=

# Conexión directa (migraciones / drizzle-kit). Opcional.
DATABASE_URL_UNPOOLED=

# POST /api/revalidate (header x-revalidate-secret). También secret de GitHub Actions.
REVALIDATE_SECRET=
