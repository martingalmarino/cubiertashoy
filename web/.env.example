# URL pública del sitio (sin slash final). Obligatoria en Vercel Production.
# Fallback de código en production: https://www.precioneumaticos.com.ar
# Preview/dev sin esta var: https://$VERCEL_URL o localhost.
NEXT_PUBLIC_SITE_URL=https://www.precioneumaticos.com.ar

# Neon Postgres (pooled). Nunca commitear valores reales.
DATABASE_URL=

# Conexión directa (migraciones / drizzle-kit). Opcional.
DATABASE_URL_UNPOOLED=

# POST /api/revalidate (header x-revalidate-secret). También secret de GitHub Actions.
REVALIDATE_SECRET=

# Leads (gomerías). Al menos uno de RESEND_* o LEAD_WEBHOOK.
RESEND_API_KEY=
RESEND_FROM=Precio Neumáticos <onboarding@resend.dev>
LEAD_NOTIFY_EMAIL=
LEAD_WEBHOOK=
LEAD_IP_SALT=

# Mercado Libre (scraper + afiliados). Obtener en developers.mercadolibre.com.ar
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
# Tag del programa de afiliados (query matt_tool en permalinks)
ML_AFFILIATE_TAG=

# AdSense (desactivado hasta aprobación). Reserva altura vía <AdSlot />.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
